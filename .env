# Expo inlines EXPO_PUBLIC_* into the bundle at build time.
#
# ⚠ This file is what the LOCALLY-SERVED bundle uses. `eas.json` env only applies
# to bundles EAS itself builds — so without this, an app running against local
# Metro falls back to `sandbox` and registers the wrong environment (ADR 0026).
#
# `production` is right for every profile that can obtain a token: EAS internal
# distribution is ad-hoc, and ad-hoc, TestFlight and App Store all carry
# `aps-environment: production`.
#
# ⚠ Override to `sandbox` ONLY for a build made with a genuine *Development*
# provisioning profile (e.g. `npx expo run:ios` signed in Xcode with a dev profile).
EXPO_PUBLIC_APNS_ENV=production

# ── Supabase Auth ────────────────────────────────────────────────────────────
#
# ⚠ AUTH ONLY. This key reaches `/auth/v1` and nothing else — the `profiles`,
# `feed_selections` and `subscriptions` grants are revoked for it, so a table
# read answers `401 / 42501`, not `200 []`. Every byte of football data still
# comes from `crono-gol.com` (ADR 0009 / 0039). Never add a Supabase table read.
#
# ⚠ The project is on a CUSTOM DOMAIN, not `<ref>.supabase.co`. Both resolve;
# this one matches `senpai-backend/.env` and the web app. Do not "correct" it.
#
# ⚠ Publishable, not secret — it is designed to be held by clients and the web
# app already ships it in the browser bundle.
EXPO_PUBLIC_SUPABASE_URL=https://altagamafc.crono-gol.com
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_pE57YqszjUFl1pU0fXjc2A_1ha8EQri

/*
  Las cadenas propias de la tarjeta ampliada. Ver en.lproj/Localizable.strings.

  ⚠ Los micro-rótulos van en MAYÚSCULAS y muy espaciados — el diseño los usa
  como etiqueta, no como frase. `EMPIEZA EN 30` es deliberadamente más corto que
  el inglés: a 9.5pt con .14em de tracking, el ancho es el límite real.
*/

"KICKOFF IN 1 HOUR" = "EMPIEZA EN 1 HORA";
"KICKOFF IN 30" = "EMPIEZA EN 30";
"KICKOFF IN 15" = "EMPIEZA EN 15";
"KICKOFF MOVED" = "CAMBIO DE HORARIO";
"POSTPONED" = "APLAZADO";

"TODAY" = "HOY";
"TOMORROW" = "MAÑANA";
"WAS" = "ANTES";
"NOW" = "AHORA";
"NO NEW DATE" = "SIN FECHA";

"Calendar entry moved for you" = "Tu calendario ya está actualizado";
"Removed from your calendar" = "Eliminado de tu calendario";

/*
  La tarjeta de partido en directo (ADR 0053).

  ⚠ Una clave que falte en CUALQUIERA de los dos .lproj imprime la clave en
  crudo sobre la tarjeta — sin error y sin alternativa.
*/

"GOAL" = "GOL";
"RED CARD" = "ROJA";
"FULL TIME" = "FINAL";

/* ⚠ El prima tipográfico, no un apóstrofo. */
"%d’ left" = "quedan %d’";
/* ⚠ Nombra al CLUB, nunca la abreviatura. */
"%@ 10 men" = "%@ con diez";
"%@ 9 men" = "%@ con nueve";

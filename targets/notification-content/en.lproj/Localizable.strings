/*
  The long-look card's own strings.

  ⚠⚠ A SECOND SOURCE OF TRUTH. This extension is a separate binary and cannot
  read `src/lib/i18n/copy.ts`. Adding a string to the card means adding it here
  AND in es.lproj — there is no fallback that would make a missing translation
  visible, iOS just prints the key.

  ⚠ Nothing here is notification COPY. The title and body come from
  `copy.reminders` (local) or `senpai-backend` (push) and are suppressed on this
  card by `UNNotificationExtensionDefaultContentHidden`. These are labels on the
  card's own furniture.
*/

/* ⚠ One per lead time (ADR 0040) — see `MatchCard.eyebrowText`. Adding a lead
   to `REMINDER_LEAD_OPTIONS` means adding a line here and in es.lproj. */
"KICKOFF IN 1 HOUR" = "KICKOFF IN 1 HOUR";
"KICKOFF IN 30" = "KICKOFF IN 30";
"KICKOFF IN 15" = "KICKOFF IN 15";
"KICKOFF MOVED" = "KICKOFF MOVED";
"POSTPONED" = "POSTPONED";

"TODAY" = "TODAY";
"TOMORROW" = "TOMORROW";
"WAS" = "WAS";
"NOW" = "NOW";
"NO NEW DATE" = "NO NEW DATE";

"Calendar entry moved for you" = "Calendar entry moved for you";
"Removed from your calendar" = "Removed from your calendar";

/*
  The live match card (ADR 0053).

  ⚠ A key missing from EITHER .lproj prints the raw key on the card — no error,
  no fallback. Adding a segment to the meta row means adding it in both files.
*/

"GOAL" = "GOAL";
"RED CARD" = "RED CARD";
"FULL TIME" = "FULL TIME";

/* ⚠ The typographic prime, not an apostrophe — the design specifies it. */
"%d’ left" = "%d’ left";
/* ⚠ Names the CLUB, never an abbreviation: `GET 10 men` reads as a typo. */
"%@ 10 men" = "%@ 10 men";
"%@ 9 men" = "%@ 9 men";
